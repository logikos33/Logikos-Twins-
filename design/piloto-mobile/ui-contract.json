{
  "$schema": "logikos/ui-contract/v1",
  "product": "Twins — piloto mobile",
  "conventions": {
    "screenAttr": "data-screen",
    "stateAttr": "data-state",
    "plugAttr": "data-plug",
    "plugFormat": "<tela>.<acao>",
    "rules": [
      "Todo elemento interativo tem data-plug com o nome exato deste arquivo.",
      "A raiz de cada tela tem data-screen e data-state; todo estado listado é renderizável com dados fake.",
      "Nomes idênticos no Claude Design e no código. Plug fora deste arquivo é achado, não invenção.",
      "Estado é sempre cor + ícone + palavra. Ciano só em elemento interativo.",
      "Medidas em JetBrains Mono, vírgula decimal, unidade m: 0,84 m · 2,41 m · 12,3 m (>= 10 m, 1 casa)."
    ]
  },
  "screens": [
    {
      "id": "entry",
      "route": "/p/:token",
      "purpose": "Entrada do cliente pelo link do projeto, sem cadastro.",
      "states": ["loading", "ready", "empty", "invalid-link", "offline"],
      "plugs": ["entry.load", "entry.capture.open", "entry.map.open", "entry.guide.toggle"]
    },
    {
      "id": "capture",
      "route": "/p/:token/capturar",
      "purpose": "Gravar pelo navegador com upload progressivo enquanto grava.",
      "states": ["permission-prompt", "permission-denied", "unsupported", "https-required", "idle", "recording", "stopping", "portrait-hint"],
      "plugs": ["capture.start", "capture.stop", "capture.torch", "capture.fallback-file", "capture.guide.dismiss"],
      "limits": { "maxDurationS": 120, "minDurationS": 20, "partMinBytes": 5242880, "timesliceMs": 3000, "audio": false }
    },
    {
      "id": "job",
      "route": "/p/:token/jobs/:jobId",
      "purpose": "Envio, fila, processamento e resultado de um job.",
      "states": ["uploading", "upload-paused-offline", "queued", "processing", "completed", "failed", "cancelled"],
      "stages": ["extract", "blur", "reconstruct", "fuse", "publish"],
      "errorCodes": ["video-too-short", "video-too-long", "no-motion", "gpu-unavailable", "timeout", "internal"],
      "plugs": ["job.poll", "job.cancel", "job.retry", "job.map.open"]
    },
    {
      "id": "viewer",
      "route": "/m/:mapId",
      "purpose": "Mapa 3D no toque: navegar, medir, anotar, buscar, camadas, compartilhar.",
      "states": ["loading-lod", "ready", "loading-full", "tool-measure", "tool-annotate", "tool-search", "layers", "share", "error"],
      "plugs": [
        "viewer.load", "viewer.lod.toggle",
        "measure.start", "measure.point", "measure.remove",
        "annotate.start", "annotate.photo", "annotate.save", "annotate.remove",
        "search.query", "search.focus",
        "layers.toggle",
        "share.create", "share.copy", "share.whatsapp", "share.revoke",
        "export.request"
      ],
      "layers": ["cloud-lod", "cloud-full", "pins", "objects", "trajectory"]
    },
    {
      "id": "shared",
      "route": "/s/:shareToken",
      "purpose": "Link público somente leitura, com validade.",
      "states": ["loading", "ready", "expired", "revoked"],
      "plugs": ["shared.load", "shared.search.query", "shared.search.focus", "shared.layers.toggle"]
    },
    {
      "id": "admin",
      "route": "/admin",
      "purpose": "Operação do piloto pelo Vitor: projetos, jobs, custo, proveniência, links, limites.",
      "states": ["login", "projects", "project-detail", "jobs", "job-detail", "links", "config", "confirm-destructive"],
      "plugs": [
        "admin.login",
        "admin.project.create", "admin.project.link.copy", "admin.project.link.revoke",
        "admin.job.filter", "admin.job.open", "admin.job.archive", "admin.job.purge", "admin.job.rerun",
        "admin.link.revoke",
        "admin.config.save",
        "admin.export.request"
      ]
    },
    {
      "id": "dev-states",
      "route": "/dev/states",
      "purpose": "Só em DEV: renderiza cada estado de cada tela com dados fake, para QA e teste de cobertura.",
      "states": ["index"],
      "plugs": []
    }
  ],
  "viewModels": {
    "Project": { "id": "string", "name": "string", "captureUrl": "string", "maps": "Map[]" },
    "Map": { "id": "string", "jobId": "string", "name": "string", "createdAt": "iso", "nPoints": "int", "state": "queued|running|completed|failed" },
    "Job": {
      "id": "string", "projectId": "string",
      "state": "queued|running|completed|failed|cancelled",
      "stage": "extract|blur|reconstruct|fuse|publish|null",
      "progress": "0..1", "queuePosition": "int|null", "elapsedS": "int",
      "videoDurationS": "int", "uploadedBytes": "int", "totalBytes": "int",
      "error": { "code": "video-too-short|video-too-long|no-motion|gpu-unavailable|timeout|internal", "message": "string" },
      "result": { "cloudLodUrl": "string", "cloudFullUrl": "string", "nPoints": "int", "nKeyframes": "int", "gpuSeconds": "int", "costUsd": "number" },
      "provenance": { "workerCommit": "sha", "engineCommit": "sha", "imageSha": "sha", "weightsSha256": "sha" }
    },
    "Measurement": { "id": "string", "mapId": "string", "a": "[x,y,z]", "b": "[x,y,z]", "meters": "number", "createdAt": "iso" },
    "Annotation": { "id": "string", "mapId": "string", "position": "[x,y,z]", "photoUrl": "string|null", "note": "string", "tag": "string|null", "createdAt": "iso" },
    "SearchResult": { "query": "string", "label": "string", "count": "int", "hits": [{ "id": "string", "position": "[x,y,z]" }] },
    "ShareLink": { "id": "string", "mapId": "string", "url": "string", "expiresAt": "iso", "readOnly": true, "views": "int", "revoked": "bool" },
    "Config": { "maxDurationS": "int", "maxSizeMb": "int", "gpuUsdPerS": "number", "defaultLinkDays": "int", "rawVideoTtlDays": "int (documentado, desativado no piloto)" }
  }
}
