# Imagem de DESENVOLVIMENTO da web (hot reload). A imagem de produção é construída
# pelo Railway a partir do repositório — ver railway.json (D7).
FROM node:22-alpine

WORKDIR /app

# Instalar as dependências antes de copiar o código aproveita o cache de camadas:
# mudar um componente não refaz o `npm ci`. `--ignore-scripts` porque o postinstall
# (prisma generate) precisa do schema, que só chega no COPY seguinte.
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npx prisma generate

ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000
# `-H 0.0.0.0` é obrigatório: o padrão escuta só em localhost DENTRO do container,
# e a porta publicada não alcançaria nada.
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
