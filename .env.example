# =============================================================================
# Logikos Twins — configuração
#
# Copie para `.env` na raiz (`cp .env.example .env`) e rode `make dev`.
# Os valores abaixo funcionam como estão: o ambiente de desenvolvimento inteiro sobe
# SEM NENHUMA CREDENCIAL EXTERNA. Nada aqui é segredo real.
#
# Onde estiver escrito [PLUG-IN], é o que muda quando o Vitor conectar as contas de
# verdade. Nenhuma linha de código muda junto — esse é o desenho (ADR-0003/0004).
# =============================================================================

# --- Identidade -------------------------------------------------------------
APP_NAME="Logikos Twins"
# [PLUG-IN] vira o domínio definitivo. É a URL que o webhook do RunPod chama de volta,
# então precisa ser alcançável pela internet em produção.
APP_URL=http://localhost:3000

# --- Banco ------------------------------------------------------------------
# [PLUG-IN] vira o DATABASE_URL do Postgres do Railway.
# Porta 5433 no host: máquinas com Postgres nativo costumam ocupar a 5432 (era o
# caso aqui). Dentro do compose os serviços usam postgres:5432 normalmente.
DATABASE_URL=postgresql://twins:twins-dev@localhost:5433/twins

# --- Storage S3-compatível --------------------------------------------------
# Dev: MinIO no compose. [PLUG-IN]: Cloudflare R2 — mesmo protocolo, mesmo código.
#
# S3_ENDPOINT      → como os SERVIÇOS alcançam o storage
# S3_PUBLIC_ENDPOINT → como o NAVEGADOR alcança (a URL assinada embute o host, e o
#                      celular não resolve nomes da rede interna do Docker)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=twins-dev
S3_SECRET_ACCESS_KEY=twins-dev-secret
S3_BUCKET=logikos-twins
S3_REGION=auto
# MinIO usa bucket no caminho; o R2 usa bucket no host. [PLUG-IN] passa a `false`.
S3_FORCE_PATH_STYLE=true

# --- Execução de jobs (GPU) -------------------------------------------------
# Dev: fake-runpod. [PLUG-IN]: https://api.runpod.ai + endpoint e chave reais.
RUNPOD_BASE_URL=http://localhost:8080
RUNPOD_ENDPOINT_ID=local
RUNPOD_API_KEY=dev-nao-usado
# Autentica o webhook de volta. Trocar por segredo forte no plug-in.
RUNPOD_WEBHOOK_SECRET=webhook-secret-dev
# URL que o RUNNER usa para chamar o webhook. Só é preciso quando o runner não
# resolve a APP_URL (caso do compose: http://web:3000). Em produção, deixar vazio.
#WEBHOOK_BASE_URL=

# --- Comportamento do sósia de GPU (só no dev) ------------------------------
# synthetic   → devolve os artefatos da cena sintética (rápido, é o padrão)
# local-worker → executa o worker REAL em CPU sobre as fixtures (lento, prova o código)
FAKE_MODE=synthetic
FAKE_COLD_START_S=2
FAKE_PROCESS_S=6
# Ligue para provar que a reconciliação por polling recupera um job cujo webhook morreu.
FAKE_DROP_WEBHOOKS=false

# --- Acesso e limites -------------------------------------------------------
# Abre a galeria completa e o painel /admin. Trocar por segredo forte no plug-in.
ADMIN_TOKEN=admin-token-dev
MAX_SCANS_PER_DAY=20
MAX_VIDEO_MB=300
MAX_VIDEO_SECONDS=180

# --- Pipeline ---------------------------------------------------------------
# Extração de frames. Recalibrar por CUSTO POR SCAN depois da medição na F0 do plug-in.
EXTRACT_FPS=8

# --- Retenção (LGPD) --------------------------------------------------------
# O vídeo BRUTO é apagado após este prazo; os artefatos 3D permanecem.
# 10080 min = 7 dias (produção). No dev, baixe para poucos minutos para testar a
# retenção sem esperar uma semana.
VIDEO_RETENTION_MINUTES=10080

# --- Detector ---------------------------------------------------------------
# synthetic   → gabarito geométrico da cena sintética (o default do DEV: não
#               precisa de pesos; é o que faz a busca funcionar no compose)
# yolox       → base Apache-2.0 real; exige pesos (scripts/fetch_yolox.py).
#               [PLUG-IN] é o default de produção
# recognition → detector da Logikos (D5.5), com fallback automático para yolox
DETECTOR=synthetic
