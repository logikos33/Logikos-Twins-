# ---------------------------------------------------------------------------
# Referências do projeto (discussões, pesquisas, apresentações, planejamento
# original) — nunca versionar. Repositório é PÚBLICO desde 2026-07-27: estes
# documentos carregam contexto de negócio/mercado que não pertence a um
# checkout público (ver DECISIONS.md "Limpeza de versionamento").
# ---------------------------------------------------------------------------
/referencias/
/*.pptx
/*.docx
/*.xlsx
/*.key
/*.pdf
# Documentos de planejamento nomeados — extensão .md não cai nos padrões acima.
/PROMPT-EXECUCAO.md
/plano-demo-handoff.md
/docs/design/BRIEFING-FRONTEND.md

# ---------------------------------------------------------------------------
# Segredos
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.eslintcache
coverage/
playwright-report/
test-results/

# ---------------------------------------------------------------------------
